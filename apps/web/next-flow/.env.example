# ==============================================================================
# FLOW / next-flow — Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development. Use placeholders here only.
# Never commit local/production env files, database passwords, or live keys.
# Local values belong in .env.local. Preview and production values belong in
# their deployment environment's encrypted secret store and must be configured
# independently; never promote a local env file between environments.

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# APP_ENV comes from the deployment target: development | preview | production.
# APP_URL is the public origin for that environment. LOG_LEVEL is set by the
# application's observability policy.

APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Legacy FoodFlow internal authentication — non-authoritative after P02/R03
# ------------------------------------------------------------------------------
# These values remain only for source-level rollback until P02/R06 cleanup.
# Live login/session authority MUST NOT read them after the Auth.js cutover.

FOODFLOW_INTERNAL_EMAIL=
FOODFLOW_INTERNAL_PASSWORD=
FOODFLOW_SESSION_SECRET=

# ------------------------------------------------------------------------------
# Auth.js — authoritative internal session, server only
# ------------------------------------------------------------------------------
# Generate AUTH_SECRET with `npx auth secret` in each target environment.
# Do not reuse FOODFLOW_SESSION_SECRET. No OAuth provider is enabled in P02/R03.

AUTH_SECRET=
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# Supabase Postgres — server only
# ------------------------------------------------------------------------------
# DATABASE_URL: Supabase Dashboard > Connect > transaction pooler. Used by the
# Next.js runtime only when a server DB operation executes.
# DATABASE_DIRECT_URL: Dashboard > Connect > direct/session connection. Tooling
# only: migrations, schema inspection and Kysely code generation. Normal app
# requests must never use this URL.

DATABASE_URL=
DATABASE_DIRECT_URL=

# Optional runtime pool tuning. Defaults are intentionally conservative for
# serverless environments. Keep these server-only; never prefix with NEXT_PUBLIC_.
DATABASE_POOL_MAX=4
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# Supabase API — optional
# ------------------------------------------------------------------------------
# Add these only when FLOW intentionally enables Storage, Realtime, or an
# approved browser client. Domain data remains server-mediated.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only API key. Never prefix with NEXT_PUBLIC_. Prefer a narrow database
# role for normal domain traffic.
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Omise / Opn merchant payments
# ------------------------------------------------------------------------------
# Suitable only for sandbox or an approved single-merchant pilot. Multi-tenant
# merchant credentials must resolve through merchant account records and an
# approved secret store; do not create numbered per-merchant env variables.

NEXT_PUBLIC_OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_MERCHANT_WEBHOOK_SECRET=
OMISE_MERCHANT_PAYMENTS_ENABLED=false

# ------------------------------------------------------------------------------
# FLOW SaaS billing safety switch
# ------------------------------------------------------------------------------
# Provider credentials are added only with the billing implementation.

STRIPE_BILLING_ENABLED=false
