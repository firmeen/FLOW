# ==============================================================================
# FLOW / next-flow — Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local, .env.production, database passwords, or live keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info


# ------------------------------------------------------------------------------
# Temporary FoodFlow Internal Authentication
# ------------------------------------------------------------------------------
# CURRENT IMPLEMENTATION ONLY
# Remove these variables after Auth.js migration is completed.
#
# FOODFLOW_SESSION_SECRET must be at least 32 characters.
# Never use the development default credentials in production.

FOODFLOW_INTERNAL_EMAIL=
FOODFLOW_INTERNAL_PASSWORD=
FOODFLOW_SESSION_SECRET=


# ------------------------------------------------------------------------------
# Auth.js — Target Authentication
# ------------------------------------------------------------------------------
# Generate AUTH_SECRET with:
# npx auth secret

AUTH_SECRET=
AUTH_TRUST_HOST=true

# Add only the provider that FLOW actually enables.
# Example: Google OAuth
#
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Usually not required on Vercel because Auth.js can infer the host.
# AUTH_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# Supabase Postgres
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Supabase Dashboard → Connect → Transaction pooler
# Used by the Next.js/Vercel runtime.
#
# DATABASE_DIRECT_URL:
# Supabase Dashboard → Connect → Direct connection
# Used only by migrations, schema tools, and trusted CI.

DATABASE_URL=
DATABASE_DIRECT_URL=


# ------------------------------------------------------------------------------
# Supabase API — Optional
# ------------------------------------------------------------------------------
# Enable these only when FLOW intentionally uses Supabase Storage,
# Realtime, or an approved browser-side Supabase client.
#
# Domain data should remain server-mediated under the current architecture.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase API key.
# Never prefix this variable with NEXT_PUBLIC_.
# Prefer a narrow database role instead when possible.

SUPABASE_SECRET_KEY=


# ------------------------------------------------------------------------------
# Stripe — FLOW SaaS Billing
# ------------------------------------------------------------------------------
# ร้านจ่ายค่าสมาชิกให้ FLOW
#
# Use Stripe Sandbox/Test keys for local, preview, and test environments.
# Prefer a Restricted API Key when its permissions cover the integration.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=

# Stripe Product/Price mappings should be stored in application configuration
# or the database, not expanded into dozens of environment variables.


# ------------------------------------------------------------------------------
# Omise / Opn — Merchant Payments
# ------------------------------------------------------------------------------
# ลูกค้าจ่ายเงินให้ร้าน
#
# These variables are suitable for Sandbox or an initial single-merchant pilot.
# Production multi-tenant merchant credentials must be resolved per merchant
# from an approved secret store, not OMISE_MERCHANT_001_SECRET_KEY-style vars.

NEXT_PUBLIC_OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_MERCHANT_WEBHOOK_SECRET=

# Enable only after FLOW receives approval for Account Chaining / PayFac.
# OMISE_CHAIN_KEY=


# ------------------------------------------------------------------------------
# Global payment safety switches
# ------------------------------------------------------------------------------
# These variables only become effective after code explicitly implements them.

STRIPE_BILLING_ENABLED=false
OMISE_MERCHANT_PAYMENTS_ENABLED=false